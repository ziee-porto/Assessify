{
  "name": "assessify",
  "version": "0.1.0",
  "private": true,
  "description": "English placement testing for Karya Bangsa School",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "check": "node --check src/server.js && node --check public/app.js",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "googleapis": "^176.0.0",
    "mysql2": "^3.24.2",
    "pdfkit": "^0.20.1"
  },
  "engines": {
    "node": ">=20"
  }
}
